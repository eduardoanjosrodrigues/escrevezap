<%# ============================================================== %>
<%# SEO metadata + structured data %>
<%# ============================================================== %>
<% content_for :title_full, "Transcrever Áudio do WhatsApp em Texto | EscreveZap" %>
<% content_for :description, "Transcreva áudios do WhatsApp em texto: encaminhe o áudio para o EscreveZap e receba a transcrição em segundos, sem instalar nada. No Pro, a transcrição aparece direto na conversa." %>
<% content_for :jsonld do %>
  <%= faq_jsonld(HomeContent::FAQS) %>
  <%= howto_jsonld(name: "Como transcrever um áudio do WhatsApp em texto", steps: HomeContent::HOW_TO_STEPS) %>
<% end %>

<%# ============================================================== %>
<%# HERO %>
<%# ============================================================== %>
<section class="relative overflow-hidden bg-(--color-bg)" aria-labelledby="hero-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-16 md:pt-16 md:pb-24">

    <%# ── Copy ── %>
    <div class="text-center max-w-3xl mx-auto">
      <%# Badge %>
      <div class="inline-flex items-center gap-1.5 bg-(--color-brand-light) text-(--color-brand) text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
        <i class="ph ph-sparkle"></i>
        Transcrição de áudios no WhatsApp
      </div>

      <%# Headline %>
      <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-(--color-text) leading-tight tracking-tight">
        Transcreva áudios do WhatsApp<br class="hidden sm:block">
        <span class="text-(--color-brand)">em texto, na hora.</span>
      </h1>

      <%# Subheadline %>
      <p class="mt-5 text-lg md:text-xl text-(--color-text-muted) leading-relaxed max-w-2xl mx-auto">
        Encaminhe o áudio para o EscreveZap e receba o texto em segundos, no próprio WhatsApp. Sem instalar nada, sem conectar nada.
      </p>

      <%# CTAs %>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <%= link_to official_whatsapp_url("home-hero"),
              target: "_blank", rel: "noopener",
              class: "inline-flex items-center justify-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3.5 rounded-xl transition-colors text-sm shadow-sm" do %>
          <i class="ph ph-whatsapp-logo text-lg"></i>
          Testar grátis no WhatsApp
        <% end %>
        <a href="#como-funciona"
           class="inline-flex items-center justify-center gap-1.5 text-(--color-text-muted) hover:text-(--color-text) font-medium px-6 py-3.5 text-sm transition-colors">
          <i class="ph ph-play-circle text-lg"></i>
          Ver como funciona
        </a>
      </div>

      <%# Micro-copy %>
      <p class="mt-4 text-xs text-(--color-text-muted)">
        Grátis para começar &middot; Cancele quando quiser
      </p>
    </div>

    <%# ── The sales script as an animated "video" ── %>
    <div class="mt-12 md:mt-14 max-w-5xl mx-auto">
      <%= render "pages/hero_video" %>
    </div>

  </div>
</section>


<%# ============================================================== %>
<%# TRUST BAR %>
<%# ============================================================== %>
<section data-track-section="confianca" class="bg-(--color-surface) border-y border-gray-100 py-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
      <% [
        { icon: "ph-check-circle",   text: "Funciona no seu próprio WhatsApp" },
        { icon: "ph-sim-card",       text: "Sem trocar de número" },
        { icon: "ph-timer",          text: "Sem cadastro e sem instalar nada" },
        { icon: "ph-smiley",         text: "No Pro: reaja com emoji e transcreva na conversa" }
      ].each do |t| %>
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-(--color-brand-subtle) flex items-center justify-center shrink-0">
            <i class="ph <%= t[:icon] %> text-(--color-brand) text-sm"></i>
          </div>
          <span class="text-sm text-(--color-text)"><%= t[:text] %></span>
        </div>
      <% end %>
    </div>
  </div>
</section>


<%# ============================================================== %>
<%# HOW IT WORKS %>
<%# ============================================================== %>
<section data-track-section="como-funciona" id="como-funciona" class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-extrabold text-(--color-text) tracking-tight">
        Funciona em 10 segundos.
      </h2>
      <p class="mt-3 text-(--color-text-muted) text-lg">Três toques para nunca mais precisar esperar para ouvir.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% [
        {
          num: "1",
          icon: "ph-hand-tap",
          title: "Segure o áudio",
          body:  "Recebeu um áudio e não pode ouvir? Em qualquer conversa, segure a mensagem de voz."
        },
        {
          num: "2",
          icon: "ph-arrow-bend-up-right",
          title: "Encaminhe para o EscreveZap",
          body:  "Toque em Encaminhar e escolha o EscreveZap. Na primeira vez, é só mandar um oi para salvar o contato."
        },
        {
          num: "3",
          icon: "ph-chat-text",
          title: "Leia a transcrição",
          body:  "Em poucos segundos o texto chega na conversa com o EscreveZap. Sem abrir outro app."
        }
      ].each do |step| %>
        <div class="text-center">
          <div class="relative inline-block mb-5">
            <div class="w-16 h-16 rounded-2xl bg-(--color-brand-light) flex items-center justify-center">
              <i class="ph <%= step[:icon] %> text-(--color-brand) text-3xl"></i>
            </div>
            <div class="absolute -top-1.5 -right-1.5 w-6 h-6 rounded-full bg-(--color-brand) text-white text-xs font-bold flex items-center justify-center">
              <%= step[:num] %>
            </div>
          </div>
          <h3 class="text-base font-bold text-(--color-text) mb-2"><%= step[:title] %></h3>
          <p class="text-sm text-(--color-text-muted) leading-relaxed"><%= step[:body] %></p>
        </div>
      <% end %>
    </div>

    <%# Arrow connectors — desktop only %>
    <%# (decorative, handled by grid gap + natural reading flow) %>

    <%# Premium: transcribe inside the conversation by reacting %>
    <div data-track-section="pro-demo" class="mt-14 rounded-2xl border-2 border-(--color-brand) bg-(--color-surface) p-6 md:p-10 grid grid-cols-1 md:grid-cols-2 items-center gap-10">
      <div>
        <div class="w-12 h-12 rounded-xl bg-(--color-brand) text-white flex items-center justify-center mb-5">
          <i class="ph ph-lightning text-2xl"></i>
        </div>
        <div class="flex items-center gap-2 mb-1">
          <h3 class="text-xl font-bold text-(--color-text)">Transcrever no chat</h3>
          <span class="text-xs font-semibold text-(--color-brand) bg-(--color-brand-light) px-2 py-0.5 rounded-full">Pro</span>
        </div>
        <p class="text-base text-(--color-text-muted) leading-relaxed">
          Conecte seu WhatsApp e reaja a qualquer áudio com um emoji (👍, ❤️, 😂). A transcrição aparece respondendo o áudio na própria conversa, sem precisar encaminhar.
          Dá pra testar antes de assinar: no Grátis com seus 5 áudios, no Basic até 20 vezes por mês.
        </p>
      </div>
      <div class="flex justify-center">
        <%= render "pages/whatsapp_reaction_demo" %>
      </div>
    </div>

    <div class="mt-12 text-center">
      <%= link_to official_whatsapp_url("home-como"),
            target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3.5 rounded-xl transition-colors text-sm" do %>
        <i class="ph ph-whatsapp-logo text-lg"></i>
        Começar agora
      <% end %>
    </div>
  </div>
</section>


<%# ============================================================== %>
<%# USE CASES — "Quando usar o EscreveZap" %>
<%# ============================================================== %>
<section data-track-section="quando-usar" id="quando-usar" class="bg-(--color-brand-subtle) py-20 md:py-28" aria-labelledby="use-cases-title">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 id="use-cases-title" class="text-3xl md:text-4xl font-extrabold text-(--color-text) tracking-tight">
        Quando usar o EscreveZap?
      </h2>
      <p class="mt-3 text-(--color-text-muted) text-lg max-w-xl mx-auto">
        Sempre que ouvir um áudio do WhatsApp não for uma opção — ou quando ler é simplesmente mais rápido.
      </p>
    </div>

    <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 list-none">
      <% HomeContent::USE_CASES.each do |s| %>
        <li class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100">
          <div class="text-2xl mb-2" aria-hidden="true"><%= s[:emoji] %></div>
          <h3 class="font-semibold text-(--color-text) text-sm mb-1"><%= s[:title] %></h3>
          <p class="text-xs text-(--color-text-muted) leading-relaxed"><%= s[:body] %></p>
        </li>
      <% end %>
    </ul>

  </div>
</section>


<%# ============================================================== %>
<%# WOW — BEFORE / AFTER — Basic vs Pro %>
<%# ============================================================== %>
<section data-track-section="resumo-ia" class="py-20 md:py-28 bg-(--color-surface)">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-(--color-text) tracking-tight">
        Áudio de 3 minutos?<br>Você decide quanto quer ler.
      </h2>
      <p class="mt-3 text-(--color-text-muted) text-lg">No plano Pro a IA organiza tudo antes de você ler.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <%# Basic — plain transcription %>
      <div class="rounded-2xl border border-gray-200 overflow-hidden">
        <div class="bg-(--color-surface-soft) px-5 py-3 border-b border-gray-200 flex items-center gap-2">
          <span class="text-xs font-semibold text-(--color-text-muted) uppercase tracking-wide">Gratuito / Basic</span>
        </div>
        <div class="p-5 space-y-3">
          <%# Audio bubble %>
          <div class="inline-flex items-center gap-2.5 bg-stone-100 rounded-xl px-3 py-2">
            <i class="ph ph-microphone text-(--color-text-muted) text-sm"></i>
            <div class="flex items-center gap-px">
              <div class="w-0.5 h-2 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-4 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-5 bg-gray-400 rounded-full"></div>
              <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-4 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-2 bg-gray-300 rounded-full"></div>
            </div>
            <span class="text-xs text-gray-400">3:12</span>
          </div>
          <%# Reply bubble %>
          <div class="bg-(--color-brand-light) rounded-xl px-4 py-3">
            <p class="text-sm text-(--color-accent) leading-relaxed">
              "Então, amanhã às duas você pode confirmar? E aquele contrato precisa ser revisado antes, tá? Vou precisar que você veja isso com atenção porque tem uns pontos importantes lá no terceiro parágrafo. Me manda uma mensagem quando der."
            </p>
            <p class="text-xs text-(--color-brand)/50 mt-2" style="font-size:10px">via EscreveZap</p>
          </div>
        </div>
      </div>

      <%# Pro — summary + organized transcript %>
      <div class="rounded-2xl border-2 border-(--color-brand) overflow-hidden shadow-lg">
        <div class="bg-(--color-brand) px-5 py-3 flex items-center justify-between">
          <span class="text-xs font-bold text-white uppercase tracking-wide">Plano Pro</span>
          <span class="inline-flex items-center gap-1 bg-white/20 text-white text-xs font-semibold px-2 py-0.5 rounded-full">
            <i class="ph ph-sparkle text-xs"></i> IA
          </span>
        </div>
        <div class="p-5 space-y-3">
          <%# Audio bubble %>
          <div class="inline-flex items-center gap-2.5 bg-stone-100 rounded-xl px-3 py-2">
            <i class="ph ph-microphone text-(--color-text-muted) text-sm"></i>
            <div class="flex items-center gap-px">
              <div class="w-0.5 h-2 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-4 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-5 bg-gray-400 rounded-full"></div>
              <div class="w-0.5 h-3 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-4 bg-gray-300 rounded-full"></div>
              <div class="w-0.5 h-2 bg-gray-300 rounded-full"></div>
            </div>
            <span class="text-xs text-gray-400">3:12</span>
          </div>
          <%# Pro reply bubble %>
          <div class="bg-(--color-brand-light) rounded-xl px-4 py-3 border border-(--color-brand)/20">
            <p class="text-xs font-bold text-(--color-brand) mb-1.5">📝 Resumo rápido</p>
            <p class="text-sm text-(--color-accent) leading-relaxed mb-3">
              Confirmar reunião às 14h amanhã e revisar o 3º parágrafo do contrato antes.
            </p>
            <div class="h-px bg-(--color-brand)/20 mb-3"></div>
            <p class="text-xs font-bold text-(--color-brand) mb-1.5">📄 Transcrição completa</p>
            <p class="text-xs text-(--color-text-muted) italic leading-relaxed">
              "Então, amanhã às duas você pode confirmar? E aquele contrato precisa ser revisado antes..."
            </p>
            <p class="text-xs text-(--color-brand)/50 mt-2" style="font-size:10px">via EscreveZap ✨</p>
          </div>
        </div>
      </div>

    </div>

    <p class="text-center text-sm text-(--color-text-muted) mt-8">
      Pro por apenas <strong class="text-(--color-brand)">R$19,90/mês</strong>. Menos que um café por semana.
    </p>
  </div>
</section>


<%# ============================================================== %>
<%# TRY THE ENGINE — Live audio transcription demo %>
<%# ============================================================== %>
<section data-track-section="testar" id="testar" class="py-20 md:py-28 bg-(--color-brand-subtle)">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-1.5 bg-white text-(--color-brand) text-xs font-semibold px-3 py-1.5 rounded-full mb-5 shadow-sm">
        <i class="ph ph-sparkle"></i>
        Teste agora — leva 10 segundos
      </div>
      <h2 class="text-3xl md:text-4xl font-extrabold text-(--color-text) tracking-tight">
        Nosso motor é muito melhor<br class="hidden sm:block">
        que o do WhatsApp.
      </h2>
      <p class="mt-4 text-(--color-text-muted) text-lg max-w-xl mx-auto leading-relaxed">
        Grave um áudio de até <strong class="text-(--color-text)">10 segundos</strong> e veja o resultado completo do plano Pro: resumo + transcrição formatada por IA.
      </p>
    </div>

    <div data-controller="audio-recorder"
         data-audio-recorder-url-value="<%= try_transcribe_path %>"
         data-state="idle"
         class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">

      <%# Recorder UI %>
      <div class="p-7 md:p-10">

        <div class="flex flex-col items-center gap-5">
          <%# Record button %>
          <button type="button"
                  data-audio-recorder-target="recordBtn"
                  data-action="click->audio-recorder#toggle"
                  class="group relative w-24 h-24 rounded-full bg-(--color-brand) hover:bg-(--color-brand-dark) text-white flex items-center justify-center shadow-lg shadow-(--color-brand)/30 transition-all focus:outline-none focus:ring-4 focus:ring-(--color-brand)/30">
            <%# Pulse rings — only while recording %>
            <span class="absolute inset-0 rounded-full bg-(--color-brand)/40 animate-ping recording-only"></span>
            <span class="absolute inset-0 rounded-full bg-(--color-brand)/20 animate-ping recording-only" style="animation-delay:.4s"></span>
            <i data-audio-recorder-target="recordIcon" class="ph ph-microphone text-2xl relative"></i>
          </button>

          <%# Label + status %>
          <div class="text-center">
            <p data-audio-recorder-target="recordLabel" class="text-base font-semibold text-(--color-text)">Gravar áudio</p>
            <p data-audio-recorder-target="status" class="text-sm text-(--color-text-muted) mt-1 min-h-[1.25rem]"></p>
          </div>

          <%# Timer + progress bar %>
          <div class="w-full max-w-sm">
            <div class="flex items-center justify-between text-xs text-(--color-text-muted) mb-1.5">
              <span data-audio-recorder-target="timer">0,0s</span>
              <span>máx. 10s</span>
            </div>
            <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden">
              <div data-audio-recorder-target="progress"
                   class="h-full bg-(--color-brand) rounded-full transition-all duration-100"
                   style="width:0%"></div>
            </div>
          </div>
        </div>

        <%# Error state %>
        <div data-audio-recorder-target="error" class="hidden mt-6">
          <div class="flex items-start gap-3 bg-red-50 border border-red-100 rounded-xl px-4 py-3">
            <i class="ph ph-warning-circle text-red-500 text-lg shrink-0 mt-0.5"></i>
            <p data-audio-recorder-target="errorText" class="text-sm text-red-700 leading-relaxed"></p>
          </div>
        </div>

        <%# Result — Pro-style WhatsApp bubble %>
        <div data-audio-recorder-target="result" class="hidden mt-8">
          <div class="rounded-2xl border-2 border-(--color-brand) overflow-hidden shadow-lg">
            <div class="bg-(--color-brand) px-5 py-3 flex items-center justify-between">
              <span class="text-xs font-bold text-white uppercase tracking-wide">Resultado — Plano Pro</span>
              <span class="inline-flex items-center gap-1 bg-white/20 text-white text-xs font-semibold px-2 py-0.5 rounded-full">
                <i class="ph ph-sparkle text-xs"></i> IA
              </span>
            </div>
            <div class="p-5 bg-(--color-brand-light)">
              <%# Audio bubble %>
              <div class="inline-flex items-center gap-2.5 bg-white rounded-xl px-3 py-2 shadow-sm mb-4">
                <i class="ph ph-microphone text-(--color-brand) text-sm"></i>
                <div class="flex items-center gap-px">
                  <div class="w-0.5 h-2 bg-(--color-brand)/40 rounded-full"></div>
                  <div class="w-0.5 h-4 bg-(--color-brand)/40 rounded-full"></div>
                  <div class="w-0.5 h-3 bg-(--color-brand)/40 rounded-full"></div>
                  <div class="w-0.5 h-5 bg-(--color-brand)/60 rounded-full"></div>
                  <div class="w-0.5 h-3 bg-(--color-brand)/40 rounded-full"></div>
                  <div class="w-0.5 h-4 bg-(--color-brand)/40 rounded-full"></div>
                  <div class="w-0.5 h-2 bg-(--color-brand)/40 rounded-full"></div>
                </div>
                <span class="text-xs text-(--color-brand)/60">seu áudio</span>
              </div>

              <%# Summary block — hidden when too short %>
              <div data-audio-recorder-target="summaryBlock" class="hidden">
                <p class="text-xs font-bold text-(--color-brand) mb-1.5">📝 Resumo rápido</p>
                <p data-audio-recorder-target="summaryText" class="text-sm text-(--color-accent) leading-relaxed mb-4"></p>
                <div class="h-px bg-(--color-brand)/20 mb-4"></div>
              </div>

              <%# Full formatted transcription %>
              <p class="text-xs font-bold text-(--color-brand) mb-1.5">📄 Transcrição completa</p>
              <p data-audio-recorder-target="formattedText" class="text-sm text-(--color-text) italic leading-relaxed"></p>
              <p class="text-xs text-(--color-brand)/50 mt-3" style="font-size:10px">via EscreveZap ✨</p>
            </div>
          </div>

          <div class="mt-5 text-center">
            <p class="text-sm text-(--color-text-muted) mb-3">Gostou do resultado?</p>
            <%= link_to official_whatsapp_url("home-teste"),
                  target: "_blank", rel: "noopener",
                  class: "inline-flex items-center gap-2 bg-(--color-brand) hover:bg-(--color-brand-dark) text-white font-semibold px-6 py-3 rounded-xl transition-colors text-sm shadow-sm" do %>
              <i class="ph ph-whatsapp-logo text-lg"></i>
              Quero no meu WhatsApp
            <% end %>
          </div>
        </div>
      </div>

      <%# Footer micro-copy %>
      <div class="bg-(--color-surface-soft) border-t border-gray-100 px-7 py-4 flex items-center gap-2 text-xs text-(--color-text-muted)">
        <i class="ph ph-shield-check text-(--color-brand)"></i>
        <span>Seu áudio é processado e descartado imediatamente. Não armazenamos nada.</span>
      </div>
    </div>

  </div>
</section>


<%# ============================================================== %>
<%# FEATURES %>
<%# ============================================================== %>
<section data-track-section="recursos" class="py-20 md:py-28 bg-(--color-bg)">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-(--color-text) tracking-tight">
        Tudo que você precisa.<br>Nada que você não precisa.
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% [
        { icon: "ph-whatsapp-logo",  label: "Seu próprio WhatsApp",                  pro: false },
        { icon: "ph-arrow-bend-up-right", label: "Encaminhe o áudio e receba o texto",  pro: false },
        { icon: "ph-arrows-split",   label: "Funciona com áudio de qualquer conversa", pro: false },
        { icon: "ph-timer",          label: "Sem cadastro e sem instalar nada",       pro: false },
        { icon: "ph-smiley",         label: "Transcrever no chat reagindo com emoji (Pro)", pro: true },
        { icon: "ph-sparkle",        label: "IA que organiza e formata (Pro)",         pro: true  },
        { icon: "ph-article",        label: "Resumo inteligente dos áudios (Pro)",     pro: true  },
        { icon: "ph-shield-check",   label: "Seus áudios ficam privados",             pro: false }
      ].each do |f| %>
        <div class="flex items-center gap-3 bg-(--color-surface) rounded-xl px-4 py-3.5 border border-gray-100">
          <div class="w-8 h-8 rounded-lg <%= f[:pro] ? 'bg-(--color-brand) text-white' : 'bg-(--color-brand-subtle) text-(--color-brand)' %> flex items-center justify-center shrink-0">
            <i class="ph <%= f[:icon] %> text-sm"></i>
          </div>
          <span class="text-sm text-(--color-text) flex-1"><%= f[:label] %></span>
