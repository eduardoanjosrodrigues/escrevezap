<%# iOS context menu shown below a long-pressed message %>
<div class="wa-menu" data-whatsapp-demo-target="menu">
  <div class="wa-menu-item"><%= t("pages.whatsapp_demo.menu.reply") %><i class="ph ph-arrow-bend-up-left"></i></div>
  <div class="wa-menu-item" data-whatsapp-demo-target="forwardItem"><%= t("pages.whatsapp_demo.menu.forward") %><i class="ph ph-arrow-bend-up-right"></i></div>
  <div class="wa-menu-item"><%= t("pages.whatsapp_demo.menu.star") %><i class="ph ph-star"></i></div>
  <div class="wa-menu-item"><%= t("pages.whatsapp_demo.menu.pin") %><i class="ph ph-push-pin"></i></div>
  <div class="wa-menu-item"><%= t("pages.whatsapp_demo.menu.select") %><i class="ph ph-check-circle"></i></div>
  <div class="wa-menu-item wa-menu-item--danger"><%= t("pages.whatsapp_demo.menu.delete") %><i class="ph ph-trash"></i></div>
</div>
